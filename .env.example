# Supabase Configuration
# Must point at a project with the pipeline migration applied — see
# supabase/schema.sql's "Pipeline architecture migration (2026-09-27)" section.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI-battery keys — dedicated to this project — do NOT reuse keys from
# agent-second-brain's .env. Gemini's free-tier quota is per Google Cloud
# PROJECT, so this needs its own project, not just a new key inside an
# existing one.
# Google Gemini API Key (for AI Resume Tailoring & Job URL Scraping)
GEMINI_API_KEY=your-job-hunting-only-gemini-key
# Alternative to GEMINI_API_KEY (the AI battery accepts either)
GOOGLE_API_KEY=your-google-api-key

# Additional free-tier providers for the AI battery failover chain (optional,
# but recommended so AI calls keep working with zero cost if Gemini is rate-limited)
GROQ_API_KEY=your-job-hunting-only-groq-key
OPENROUTER_API_KEY=your-job-hunting-only-openrouter-key
CEREBRAS_API_KEY=your-job-hunting-only-cerebras-key

# Real Email Delivery (nodemailer via a Gmail/Outlook app password)
# Requires 2FA enabled on the account, then an app password generated at
# https://myaccount.google.com/apppasswords (Gmail) or account security settings (Outlook).
# EMAIL_SERVICE accepts nodemailer's well-known service names, e.g. "gmail" or "hotmail".
EMAIL_SERVICE=gmail
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=Your Full Name
