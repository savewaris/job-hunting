# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (for AI Resume Tailoring & Job URL Scraping)
GEMINI_API_KEY=your-gemini-api-key
# Alternative to GEMINI_API_KEY (the AI battery accepts either)
GOOGLE_API_KEY=your-google-api-key

# Additional free-tier providers for the AI battery failover chain (optional,
# but recommended so AI calls keep working with zero cost if Gemini is rate-limited)
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
CEREBRAS_API_KEY=your-cerebras-api-key

# Real Email Delivery (nodemailer via a Gmail/Outlook app password)
# Requires 2FA enabled on the account, then an app password generated at
# https://myaccount.google.com/apppasswords (Gmail) or account security settings (Outlook).
# EMAIL_SERVICE accepts nodemailer's well-known service names, e.g. "gmail" or "hotmail".
EMAIL_SERVICE=gmail
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM_NAME=Your Full Name

# Postgres connection string for the dashboard/inbox data store.
# Supabase → Project Settings → Database → connection string. Use the pooled
# string and end it with ?sslmode=require (remote hosts without TLS are rejected).
# Newer `pg` treats sslmode=require like verify-full, so if Supabase's certificate
# is rejected, download the Supabase CA certificate from the dashboard and add
# &sslrootcert=/path/to/prod-ca-2021.crt. Do not disable certificate verification.
# Only these query params are accepted: sslmode, sslrootcert, sslcert, sslkey,
# application_name, connect_timeout (seconds). Anything else is rejected.
DATABASE_URL=
